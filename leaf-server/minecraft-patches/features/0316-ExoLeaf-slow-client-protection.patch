From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 1VicTim1 <122aaa121@gmail.com>
Date: Thu, 29 Oct 2026 17:54:05 +0500
Subject: [PATCH] ExoLeaf: slow client protection


diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index fb0e965c8f5211d5b82d13a0ee8a7a4882b8037a..1a7e552727cf3e3adf6cd614167c92b90373e235 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -650,7 +650,29 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     private static int joinAttemptsThisTick; // Paper - Buffer joins to world
     private static int currTick; // Paper - Buffer joins to world
     private static int tickSecond; // Purpur - Max joins per second
+    private long exoUnwritableSince; // ExoLeaf - slow client protection
+
     public void tick() {
+        // ExoLeaf start - slow client protection
+        if (org.dreeam.leaf.config.modules.network.SlowClientProtection.enabled && this.channel != null && this.channel.isOpen()) {
+            final io.netty.channel.ChannelOutboundBuffer buffer = this.channel.unsafe().outboundBuffer();
+            final long pending = buffer == null ? 0L : buffer.totalPendingWriteBytes();
+            final long now = System.nanoTime();
+            if (this.channel.isWritable()) {
+                this.exoUnwritableSince = 0L;
+            } else if (this.exoUnwritableSince == 0L) {
+                this.exoUnwritableSince = now;
+            }
+            final boolean tooMuch = pending > org.dreeam.leaf.config.modules.network.SlowClientProtection.maxPendingBytes;
+            final boolean tooLong = this.exoUnwritableSince != 0L
+                && now - this.exoUnwritableSince > org.dreeam.leaf.config.modules.network.SlowClientProtection.maxUnwritableNanos;
+            if (tooMuch || tooLong) {
+                LOGGER.info(ru.moonlightproject.dev.exoleaf.Ansi.line("[-] network  » {}  queue:{}KiB  client:slow"), this.getLoggableAddress(net.minecraft.server.MinecraftServer.getServer().logIPs()), pending / 1024);
+                this.disconnect(Component.literal("Connection too slow"));
+                return;
+            }
+        }
+        // ExoLeaf end - slow client protection
         this.flushQueue();
         // Paper start - Buffer joins to world
         if (Connection.currTick != net.minecraft.server.MinecraftServer.currentTick) {
diff --git a/net/minecraft/server/network/ServerConnectionListener.java b/net/minecraft/server/network/ServerConnectionListener.java
index 42408dede2808447281b49f4006c1d8b03c10bf4..72749cb87bfaf369050a896af714490585f45dfe 100644
--- a/net/minecraft/server/network/ServerConnectionListener.java
+++ b/net/minecraft/server/network/ServerConnectionListener.java
@@ -245,6 +245,7 @@ public class ServerConnectionListener {
     public void tick() {
         synchronized (this.connections) {
             this.addPendingConnections();
+            ru.moonlightproject.dev.exoleaf.SlowClients.enforce(this.connections); // ExoLeaf - slow client protection
             // Spigot start
             // This prevents players from 'gaming' the server, and strategically relogging to increase their position in the tick order
             if (org.spigotmc.SpigotConfig.playerShuffle > 0 && MinecraftServer.currentTick % org.spigotmc.SpigotConfig.playerShuffle == 0) {
