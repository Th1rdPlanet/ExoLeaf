diff --git a/net/minecraft/world/level/storage/PlayerDataStorage.java b/net/minecraft/world/level/storage/PlayerDataStorage.java
index 1c1117f3e674ddd009fb1e580670e0140a22b1c0..f7707222a555a061b3195820bb7e150f806d045e 100644
--- a/net/minecraft/world/level/storage/PlayerDataStorage.java
+++ b/net/minecraft/world/level/storage/PlayerDataStorage.java
@@ -156,6 +156,36 @@ public class PlayerDataStorage {
     }
 
     public Optional<CompoundTag> load(final NameAndId nameAndId) {
+        // ExoLeaf start - async player data prefetch: taken if login already pulled the file
+        final java.util.concurrent.CompletableFuture<Optional<CompoundTag>> prefetched = this.prefetched.remove(nameAndId);
+        if (prefetched != null) {
+            return prefetched.join();
+        }
+        // ExoLeaf end
+        return this.load0(nameAndId);
+    }
+
+    // ExoLeaf start - async player data prefetch
+    private final java.util.concurrent.ConcurrentHashMap<NameAndId, java.util.concurrent.CompletableFuture<Optional<CompoundTag>>> prefetched = new java.util.concurrent.ConcurrentHashMap<>();
+
+    /** Starts reading the player's data file on a background thread. The next load() picks it up. */
+    public void prefetch(final NameAndId nameAndId) {
+        if (this.prefetched.size() > 512) {
+            // drop finished loads of players who never made it to the configuration phase
+            this.prefetched.values().removeIf(java.util.concurrent.CompletableFuture::isDone);
+        }
+        this.prefetched.computeIfAbsent(nameAndId,
+            key -> java.util.concurrent.CompletableFuture.supplyAsync(() -> this.load0(key), Util.ioPool()));
+    }
+
+    /** Drops a pending prefetch, e.g. when a login never reaches the game phase. */
+    public void cancelPrefetch(final NameAndId nameAndId) {
+        this.prefetched.remove(nameAndId);
+    }
+    // ExoLeaf end - async player data prefetch
+
+    // ExoLeaf - async player data prefetch - the raw path so prefetch does not eat its own cache entry
+    private Optional<CompoundTag> load0(final NameAndId nameAndId) {
         Optional<CompoundTag> optTag = this.load(nameAndId, ".dat");
         if (optTag.isEmpty()) {
             this.backup(nameAndId, ".dat");
