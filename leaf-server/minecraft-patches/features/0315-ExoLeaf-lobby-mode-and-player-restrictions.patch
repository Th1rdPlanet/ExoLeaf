@@ -597,6 +597,18 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         // Leaf end - Pufferfish - async mob spawning
         // Paper start - Optional per player mob spawns
         NaturalSpawner.@Nullable SpawnState spawnCookie = null; // Leaf - Pufferfish - async mob spawning
+        // ExoLeaf start - skip mob counting while nothing can spawn
+        // The spawn state walks every entity of the world. It only feeds natural spawning, so while
+        // spawning is impossible (no categories, gamerule off, no players, lobby mode) an occasional
+        // refresh for API readers is enough; once spawning is possible it is counted every tick.
+        final boolean exoSpawningImpossible = !(this.spawnFriendlies || this.spawnEnemies)
+            || !this.level.getGameRules().get(GameRules.SPAWN_MOBS)
+            || this.level.players().isEmpty()
+            || (this.level.exoLobby && org.dreeam.leaf.config.modules.lobby.LobbyMode.disableMobSpawning);
+        if (exoSpawningImpossible && this.lastSpawnState != null && this.level.getGameTime() % 100L != 0L) {
+            // keep the last spawn state
+        } else
+        // ExoLeaf end
         if ((this.spawnFriendlies || this.spawnEnemies) && this.level.paperConfig().entities.spawning.perPlayerMobSpawns) { // don't count mobs when animals and monsters are disabled
             // Leaf start - Pufferfish - async mob spawning
             if (!asyncCountMobs) {
@@ -717,7 +729,7 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
     private void tickSpawningChunk(final LevelChunk chunk, final List<MobCategory> spawningCategories, final NaturalSpawner.SpawnState spawnCookie) {
         ChunkPos chunkPos = chunk.getPos();
         this.tickSpawningChunk(chunk); // Leaf - Pufferfish - async mob spawning
-        if (!spawningCategories.isEmpty()) {
+        if (!spawningCategories.isEmpty() && !(this.level.exoLobby && org.dreeam.leaf.config.modules.lobby.LobbyMode.disableMobSpawning)) { // ExoLeaf - lobby mode
             if (this.level.getWorldBorder().isWithinBounds(chunkPos)) { // Paper - rewrite chunk system
                 NaturalSpawner.spawnForChunk(this.level, chunk, spawnCookie, spawningCategories);
             }
